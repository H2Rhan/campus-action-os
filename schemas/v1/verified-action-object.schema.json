{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campus-action-os.example/schemas/v1/verified-action-object.schema.json",
  "title": "Campus Action OS Verified Action Object v1",
  "type": "object",
  "required": ["schema_version", "action_id", "source_document_id", "user_relevance", "target_population", "steps", "dependencies", "conditions", "exceptions", "deadline", "evidence", "confidence", "epistemic_status", "verification_status", "task_status", "change_history"],
  "properties": {
    "schema_version": {"const": "verified-action-object/v1"},
    "action_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "source_document_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "user_relevance": {"$ref": "#/$defs/userRelevance"},
    "target_population": {"$ref": "#/$defs/targetPopulation"},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "conditions": {"type": "array", "items": {"$ref": "#/$defs/condition"}},
    "exceptions": {"type": "array", "items": {"$ref": "#/$defs/exception"}},
    "deadline": {"$ref": "#/$defs/deadline"},
    "materials": {"type": "array", "items": {"$ref": "#/$defs/material"}},
    "location_or_platform": {"$ref": "#/$defs/claim"},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "confidence": {"$ref": "#/$defs/confidence"},
    "epistemic_status": {"$ref": "#/$defs/epistemicStatus"},
    "verification_status": {"$ref": "#/$defs/verificationStatus"},
    "task_status": {"$ref": "#/$defs/taskStatus"},
    "change_history": {"type": "array", "items": {"$ref": "#/$defs/change"}}
  },
  "unevaluatedProperties": false,
  "$defs": {
    "claim": {
      "type": "object", "required": ["value", "epistemic_status", "evidence_ids"],
      "properties": {
        "value": {"type": "string", "minLength": 1},
        "epistemic_status": {"$ref": "#/$defs/epistemicStatus"},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }, "unevaluatedProperties": false
    },
    "userRelevance": {
      "type": "object", "required": ["status", "reason", "evidence_ids"],
      "properties": {
        "status": {"enum": ["relevant", "not_relevant", "uncertain", "conflict", "user_confirmation_required"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }, "unevaluatedProperties": false
    },
    "targetPopulation": {
      "type": "object", "required": ["groups", "epistemic_status", "evidence_ids"],
      "properties": {
        "groups": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "epistemic_status": {"$ref": "#/$defs/epistemicStatus"},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }, "unevaluatedProperties": false
    },
    "step": {
      "type": "object", "required": ["step_id", "instruction", "epistemic_status", "evidence_ids"],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "instruction": {"type": "string", "minLength": 1},
        "materials": {"type": "array", "items": {"$ref": "#/$defs/material"}},
        "location_or_platform": {"$ref": "#/$defs/claim"},
        "epistemic_status": {"$ref": "#/$defs/epistemicStatus"},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }, "unevaluatedProperties": false
    },
    "dependency": {
      "type": "object", "required": ["dependency_id", "from_step_id", "to_step_id", "type"],
      "properties": {
        "dependency_id": {"type": "string", "minLength": 1},
        "from_step_id": {"type": "string", "minLength": 1},
        "to_step_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["blocks", "unblocks", "requires", "informs", "alternative_to", "replaces", "延期", "撤销"]},
        "condition_id": {"type": "string", "minLength": 1}
      }, "unevaluatedProperties": false
    },
    "condition": {
      "type": "object", "required": ["condition_id", "statement", "outcomes", "epistemic_status", "evidence_ids"],
      "properties": {
        "condition_id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "outcomes": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["label", "step_ids"], "properties": {"label": {"type": "string", "minLength": 1}, "step_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "unevaluatedProperties": false}},
        "epistemic_status": {"$ref": "#/$defs/epistemicStatus"},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }, "unevaluatedProperties": false
    },
    "exception": {
      "type": "object", "required": ["exception_id", "statement", "epistemic_status", "evidence_ids"],
      "properties": {"exception_id": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "epistemic_status": {"$ref": "#/$defs/epistemicStatus"}, "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "unevaluatedProperties": false
    },
    "deadline": {
      "type": "object", "required": ["value", "precision", "boundary_semantics", "epistemic_status", "evidence_ids"],
      "properties": {
        "value": {"type": ["string", "null"], "pattern": "^(null|[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(Z|[+-][0-9]{2}:[0-9]{2})?)?/[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(Z|[+-][0-9]{2}:[0-9]{2})?)?|[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(Z|[+-][0-9]{2}:[0-9]{2})?)?)$"},
        "precision": {"enum": ["date", "datetime", "date_range", "relative", "unknown"]},
        "boundary_semantics": {"enum": ["inclusive", "exclusive", "unknown"]},
        "timezone": {"type": "string", "minLength": 1},
        "epistemic_status": {"$ref": "#/$defs/epistemicStatus"},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }, "unevaluatedProperties": false
    },
    "material": {
      "type": "object", "required": ["material_id", "description", "epistemic_status", "evidence_ids"],
      "properties": {"material_id": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "epistemic_status": {"$ref": "#/$defs/epistemicStatus"}, "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "unevaluatedProperties": false
    },
    "evidence": {
      "type": "object", "required": ["evidence_id", "source_text", "page_or_image", "field_name", "epistemic_status"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "source_text": {"type": "string", "minLength": 1},
        "page_or_image": {"type": "string", "minLength": 1},
        "bounding_box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "field_name": {"enum": ["user_relevance", "target_population", "step", "dependency", "condition", "exception", "deadline", "material", "location_or_platform"]},
        "epistemic_status": {"$ref": "#/$defs/epistemicStatus"}
      }, "unevaluatedProperties": false
    },
    "confidence": {"type": "object", "required": ["score", "basis"], "properties": {"score": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "basis": {"enum": ["model", "rule_review", "user_confirmed"]}}, "unevaluatedProperties": false},
    "epistemicStatus": {"enum": ["explicit", "inferred", "unknown", "conflict", "user_confirmation_required"]},
    "verificationStatus": {"enum": ["model_output", "rule_reviewed", "user_confirmed", "rejected"]},
    "taskStatus": {"enum": ["not_created", "planned", "in_progress", "completed", "cancelled", "superseded"]},
    "change": {
      "type": "object", "required": ["change_id", "occurred_at", "actor", "change_type", "reason"],
      "properties": {"change_id": {"type": "string", "minLength": 1}, "occurred_at": {"type": "string", "format": "date-time"}, "actor": {"enum": ["model", "rule_engine", "publisher", "user", "system"]}, "change_type": {"enum": ["created", "reviewed", "confirmed", "postponed", "revoked", "replaced", "corrected"]}, "reason": {"type": "string", "minLength": 1}, "previous_action_id": {"type": "string", "minLength": 1}}, "unevaluatedProperties": false
    }
  }
}
