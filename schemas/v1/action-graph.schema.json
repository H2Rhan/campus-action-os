{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campus-action-os.example/schemas/v1/action-graph.schema.json",
  "title": "Campus Action OS Action Graph v1",
  "type": "object",
  "required": ["schema_version", "graph_id", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": "action-graph/v1"},
    "graph_id": {"type": "string", "minLength": 1},
    "nodes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["node_id", "node_type", "action_id"], "properties": {"node_id": {"type": "string", "minLength": 1}, "node_type": {"enum": ["action", "precondition", "decision", "milestone", "notice_revision"]}, "action_id": {"type": "string", "minLength": 1}, "population_groups": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "unevaluatedProperties": false}},
    "edges": {"type": "array", "items": {"type": "object", "required": ["edge_id", "from_node_id", "to_node_id", "edge_type"], "properties": {"edge_id": {"type": "string", "minLength": 1}, "from_node_id": {"type": "string", "minLength": 1}, "to_node_id": {"type": "string", "minLength": 1}, "edge_type": {"enum": ["blocks", "requires", "informs", "branches_to", "alternative_to", "postpones", "revokes", "replaces"]}, "condition_id": {"type": "string", "minLength": 1}}, "unevaluatedProperties": false}}
  },
  "unevaluatedProperties": false
}
